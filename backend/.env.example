# Copie para backend/.env e substitua os valores de exemplo.
# Não versione o .env preenchido.
NODE_ENV=development
PORT=3000

# PostgreSQL: substitua usuário, senha e nome do banco.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/dashboard_comercial

# Obrigatório: gere um segredo exclusivo de pelo menos 32 bytes.
# Exemplo de comando: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRATION_TIME=7d

# Origem do frontend para CORS e links de e-mail.
FRONTEND=http://localhost:8080
FRONTEND_URL=http://localhost:8080

# Provisionamento opcional. Deixe vazio para criar pelo modal de primeiro acesso.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Pool de conexões PostgreSQL.
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=10000
PRISMA_QUERY_LOGS=false

# Uploads: preencha para habilitar armazenamento S3 ou compatível.
STORAGE_REGION=us-east-1
STORAGE_BUCKET_NAME=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Endpoint opcional, para serviços compatíveis como MinIO.
STORAGE_ENDPOINT=

# Envio opcional de e-mail. Porta 587 usa SMTP_SECURE=false; 465 usa true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=Dashboard Comercial

# Chaves opcionais para o módulo de notificações web push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Segredo utilizado pelo utilitário de criptografia 2FA.
# A configuração desta variável não habilita autenticação 2FA no login atual.
2FA_SECRET=
