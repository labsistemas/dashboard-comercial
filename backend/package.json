{
  "name": "lab-sistemas-dashboard-backend",
  "version": "1.0.0",
  "description": "Backend API para o Lab Sistemas Dashboard",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "predev": "node ./node_modules/prisma/build/index.js generate",
    "build": "node ./node_modules/prisma/build/index.js generate && node ./node_modules/typescript/bin/tsc",
    "start": "node dist/server.js",
    "prisma:generate": "node ./node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node ./node_modules/prisma/build/index.js migrate dev --name init",
    "migrate-custom": "node ./node_modules/prisma/build/index.js migrate dev",
    "prisma:studio": "node ./node_modules/prisma/build/index.js studio",
    "init": "tsx src/scripts/init.ts",
    "setup": "npm run prisma:generate && npm run prisma:migrate && npm run init",
    "test:security": "node ./node_modules/typescript/bin/tsc && node tests/security.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1039.0",
    "@aws-sdk/s3-request-presigner": "^3.1039.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/config": "^7.10.0",
    "@types/multer": "^2.0.0",
    "@types/socket.io": "^3.0.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^10.0.9",
    "otplib": "^12.0.1",
    "pg": "^8.18.0",
    "prisma": "^7.10.0",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.12",
    "@types/nodemailer": "^6.4.21",
    "@types/pg": "^8.16.0",
    "@types/web-push": "^3.6.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.21.0",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "fast-xml-parser": "^5.3.4",
    "hono": "^4.13.4",
    "@hono/node-server": "^1.19.15",
    "lodash": "^4.17.23",
    "brace-expansion": "^5.0.8",
    "path-to-regexp": "^0.1.13",
    "defu": "^6.1.5",
    "uuid": "^14.0.0",
    "ws": "^8.20.1",
    "deepmerge-ts": "^8.0.0",
    "mysql2": "^3.23.0",
    "qs": "^6.15.3",
    "body-parser": "^1.20.6",
    "engine.io": "^6.6.7",
    "fast-xml-builder": "^1.1.7",
    "socket.io-parser": "^4.2.7",
    "tmp": "^0.2.6",
    "esbuild": "^0.28.2"
  }
}
