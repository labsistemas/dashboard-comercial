{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "types": ["node"]
  },
  "include": ["src/server.ts", "src/lib/**/*.ts", "src/middleware/**/*.ts", "src/dashboard/**/*.ts", "src/routes/**/*.ts", "src/scripts/**/*.ts", "src/services/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
